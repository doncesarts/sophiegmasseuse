---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Drawer from '../components/Drawer.astro';
import type { Locale } from '../i18n/config';
import { getTranslations } from '../i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  locale: Locale;
  /** Locale-agnostic path, e.g. "/", "/services", "/services/swedish-massage". */
  path: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
}

const { title, description, image, locale, path, noindex, structuredData } = Astro.props;
const t = getTranslations(locale);
---

<html lang={locale}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      locale={locale}
      path={path}
      noindex={noindex}
      structuredData={structuredData}
    />
  </head>

  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-4 focus:left-4 focus:bg-primary focus:text-primary-content focus:px-4 focus:py-2 focus:rounded-field">
      {t.common.skipToContent}
    </a>
    <div class="drawer">
      <input id="mobile-drawer" type="checkbox" class="drawer-toggle" title="Toggle navigation menu" />
      <div class="drawer-content flex flex-col h-full">
        <div class="flex flex-col flex-1">
          <Header locale={locale} path={path} t={t} />
          <main id="main-content" class="flex-1">
            <slot />
          </main>
        </div>
        <Footer locale={locale} path={path} t={t} />
      </div>
      <Drawer locale={locale} path={path} t={t} />
    </div>
  </body>
</html>
