---
import MainLayout from "../layouts/MainLayout.astro";
import { defaultLocale } from "../i18n/config";
import { getTranslations } from "../i18n";

interface Props {
  error: unknown;
}

const t = getTranslations(defaultLocale);
---

<MainLayout title={t.serverError.title} description={t.serverError.body} locale={defaultLocale} path="/500" noindex>
  <section class="section flex-1 flex flex-col justify-center items-center">
    <div class="container text-center grid gap-4">
      <p class="text-6xl lg:text-8xl font-serif font-bold text-primary">500</p>
      <h1>{t.serverError.title}</h1>
      <p class="text-base-content/80">{t.serverError.body}</p>
      <a href={`/${defaultLocale}`} class="btn btn-primary rounded-field mx-auto">{t.serverError.cta}</a>
    </div>
  </section>
</MainLayout>
