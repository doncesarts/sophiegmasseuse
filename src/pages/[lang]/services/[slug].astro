---
import MainLayout from '../../../layouts/MainLayout.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import CalInlineEmbed from '../../../components/CalInlineEmbed.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { breadcrumbList } from '../../../lib/schema';
import { getDiscountedPrice } from '../../../lib/pricing';
import { siteConfig } from '../../../config/site';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { defaultLocale, type Locale } from '../../../i18n/config';
import { getTranslations } from '../../../i18n';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({
    params: { lang: entry.data.lang, slug: entry.id.split('/').pop() },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'services'>;
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getTranslations(locale);
const { entry }: Props = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.split('/').pop();

const related = (await getCollection('services', (e) => e.data.lang === locale && e.id !== entry.id))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const pagePath = `/services/${slug}`;
const breadcrumbs = [
  { name: t.nav.home, href: `/${locale}` },
  { name: t.nav.services, href: `/${locale}/services` },
  { name: entry.data.title, href: `/${locale}${pagePath}` },
];
const breadcrumbSchema = breadcrumbList(
  breadcrumbs.map((b) => ({ name: b.name, url: new URL(b.href, Astro.site).toString() })),
);

const offers = (entry.data.options.length > 0
  ? entry.data.options.map((opt) => ({
      '@type': 'Offer',
      name: opt.description,
      price: getDiscountedPrice(opt.price, opt.discountPercent).finalPrice,
      priceCurrency: entry.data.currency,
    }))
  : entry.data.price
    ? [{
        '@type': 'Offer',
        price: getDiscountedPrice(entry.data.price, entry.data.discountPercent).finalPrice,
        priceCurrency: entry.data.currency,
      }]
    : []);

const serviceSchema = {
  '@type': 'Service',
  serviceType: entry.data.title,
  name: `${entry.data.title} — ${siteConfig.city}`,
  description: entry.data.shortDescription || entry.data.title,
  areaServed: siteConfig.serviceArea,
  provider: { '@id': new URL(`/${defaultLocale}#business`, Astro.site).toString() },
  ...(offers.length > 0 ? { offers } : {}),
};
---

<MainLayout
  title={`${entry.data.title} in ${siteConfig.city} — ${siteConfig.name}`}
  description={entry.data.shortDescription || entry.data.title}
  locale={locale}
  path={pagePath}
  structuredData={[breadcrumbSchema, serviceSchema]}
>
  <Breadcrumbs items={breadcrumbs} />
  <article class="page section container max-w-3xl">
    <a href={`/${locale}/services`} class="link link-primary text-sm">&larr; {t.common.backToServices}</a>
    <h1 class="mt-4">{entry.data.title}</h1>
    <img
      src={entry.data.image}
      alt={entry.data.imageAlt}
      width="1200"
      height="900"
      class="w-full max-w-xl h-auto rounded-box my-6 mx-auto"
    />
    {entry.data.options && entry.data.options.length > 0 ? (
      <div class="my-6 p-6 rounded-box bg-base-200/50 border border-base-300 not-prose">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
          <h3 class="text-lg font-serif font-semibold mb-0">{t.serviceDetail.optionsTitle}</h3>
          <span class="badge badge-secondary badge-outline text-xs font-medium">{t.common.specialOfferBadge}</span>
        </div>
        <ul class="divide-y divide-base-300/60">
          {entry.data.options.map((opt) => {
            const optionPricing = getDiscountedPrice(opt.price, opt.discountPercent);
            const priceRow = (
              <>
                <span class="font-medium text-base-content/90">{opt.description}</span>
                <span class="text-base-content/80 font-semibold flex items-baseline gap-1.5">
                  <span class="font-normal text-base-content/70">{opt.duration} {t.common.minutesShort}</span>
                  {optionPricing.discountPercent ? (
                    <>
                      <del class="font-normal text-base-content/40">{optionPricing.normalPrice} {entry.data.currency}</del>
                      <span class="badge badge-secondary badge-sm">-{optionPricing.discountPercent}%</span>
                      <span>{optionPricing.finalPrice} {entry.data.currency}</span>
                    </>
                  ) : (
                    <span>{optionPricing.finalPrice} {entry.data.currency}</span>
                  )}
                  {opt.calLink && (
                    <span class="btn btn-primary btn-xs rounded-field whitespace-nowrap">{t.common.bookNow}</span>
                  )}
                </span>
              </>
            );
            return (
              <li class="text-sm">
                {opt.calLink ? (
                  <CalInlineEmbed
                    calLink={opt.calLink}
                    ariaLabel={`${t.serviceDetail.bookOptionTitle} — ${opt.description}`}
                    closeLabel={t.common.close}
                    class="py-2.5"
                    summaryClass="flex justify-between items-center w-full gap-2"
                  >
                    {priceRow}
                  </CalInlineEmbed>
                ) : (
                  <div class="py-2.5 flex justify-between items-center">{priceRow}</div>
                )}
              </li>
            );
          })}
        </ul>
        <p class="text-xs text-base-content/60 italic mt-4 pt-2 border-t border-base-300/40">
          * {t.serviceDetail.specialOfferNotice}
        </p>
      </div>
    ) : (
      <div class="flex gap-6 text-base-content/70 mb-6 not-prose items-baseline">
        {entry.data.duration && <span>{entry.data.duration} {t.common.minutesShort}</span>}
        {entry.data.price !== undefined && (() => {
          const detailPricing = getDiscountedPrice(entry.data.price, entry.data.discountPercent);
          return (
            <span class="flex items-baseline gap-1.5">
              <span>{t.common.from}</span>
              {detailPricing.discountPercent ? (
                <>
                  <del class="text-base-content/40">{detailPricing.normalPrice} {entry.data.currency}</del>
                  <span class="badge badge-secondary badge-sm">-{detailPricing.discountPercent}%</span>
                  <span class="font-semibold text-base-content">{detailPricing.finalPrice} {entry.data.currency}</span>
                </>
              ) : (
                <span>{detailPricing.finalPrice} {entry.data.currency}</span>
              )}
            </span>
          );
        })()}
      </div>
    )}

    <Content />

    {entry.data.suitableFor.length > 0 && (
      <>
        <h2>{t.serviceDetail.suitableForTitle}</h2>
        <ul>
          {entry.data.suitableFor.map((item) => <li>{item}</li>)}
        </ul>
      </>
    )}

    {entry.data.whatToExpect.length > 0 && (
      <>
        <h2>{t.serviceDetail.whatToExpectTitle}</h2>
        <ul>
          {entry.data.whatToExpect.map((item) => <li>{item}</li>)}
        </ul>
      </>
    )}

    <h2>{t.serviceDetail.aftercareTitle}</h2>
    <ul>
      {t.serviceDetail.aftercareItems.map((item) => <li>{item}</li>)}
    </ul>

    <div class="rounded-box bg-secondary text-secondary-content p-8 my-10 text-center">
      <h2 class="text-secondary-content">{t.serviceDetail.ctaTitle}</h2>
      <p class="opacity-90 mb-6">{t.serviceDetail.ctaBody}</p>
      <a href={`/${locale}/book`} class="btn bg-base-100 text-secondary border-0 rounded-field">{t.common.bookNow}</a>
    </div>
  </article>

  {related.length > 0 && (
    <section class="container pb-20">
      <h2 class="page">{t.serviceDetail.relatedTitle}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
        {related.map((r) => (
          <ServiceCard
            title={r.data.title}
            shortDescription={r.data.shortDescription}
            duration={r.data.duration}
            price={r.data.price}
            discountPercent={r.data.discountPercent}
            currency={r.data.currency}
            options={r.data.options}
            image={r.data.image}
            imageAlt={r.data.imageAlt}
            href={`/${locale}/services/${r.id.split('/').pop()}`}
            t={t}
          />
        ))}
      </div>
    </section>
  )}
</MainLayout>
