---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbList } from '../../lib/schema';
import { locales, type Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getTranslations(locale);

const breadcrumbs = [
  { name: t.nav.home, href: `/${locale}` },
  { name: t.healthSafetyPage.title, href: `/${locale}/health-safety` },
];
const breadcrumbSchema = breadcrumbList(
  breadcrumbs.map((b) => ({ name: b.name, url: new URL(b.href, Astro.site).toString() })),
);
---

<MainLayout
  title={t.seo.healthSafety.title}
  description={t.seo.healthSafety.description}
  locale={locale}
  path="/health-safety"
  structuredData={[breadcrumbSchema]}
>
  <Breadcrumbs items={breadcrumbs} />
  <article class="page section container max-w-3xl">
    <h1>{t.healthSafetyPage.title}</h1>
    <p class="text-base-content/80 mb-8">{t.healthSafetyPage.intro}</p>

    <h2>{t.healthSafetyPage.hygieneTitle}</h2>
    <ul>
      {t.healthSafetyPage.hygieneItems.map((item) => <li>{item}</li>)}
    </ul>

    <h2>{t.healthSafetyPage.contraindicationsTitle}</h2>
    <p>{t.healthSafetyPage.contraindicationsIntro}</p>
    <ul>
      {t.healthSafetyPage.contraindicationsItems.map((item) => <li>{item}</li>)}
    </ul>
    <p class="italic text-base-content/70">{t.healthSafetyPage.disclaimerNote}</p>
  </article>
</MainLayout>
