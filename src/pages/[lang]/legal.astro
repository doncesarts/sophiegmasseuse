---
import MainLayout from '../../layouts/MainLayout.astro';
import { locales, type Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getTranslations(locale);
---

<MainLayout title={t.seo.legal.title} description={t.seo.legal.description} locale={locale} path="/legal">
  <article class="page section container max-w-3xl">
    <h1>{t.legalPage.title}</h1>
    {t.legalPage.body.map((paragraph) => <p>{paragraph}</p>)}
  </article>
</MainLayout>
