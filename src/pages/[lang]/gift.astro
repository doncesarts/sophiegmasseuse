---
import MainLayout from '../../layouts/MainLayout.astro';
import GiftEmbed from '../../components/GiftEmbed.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbList } from '../../lib/schema';
import { siteConfig } from '../../config/site';
import { locales, type Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getTranslations(locale);

const breadcrumbs = [
  { name: t.nav.home, href: `/${locale}/` },
  { name: t.nav.gift, href: `/${locale}/gift/` },
];
const breadcrumbSchema = breadcrumbList(
  breadcrumbs.map((b) => ({ name: b.name, url: new URL(b.href, Astro.site).toString() })),
);
---

<MainLayout
  title={t.seo.gift.title}
  description={t.seo.gift.description}
  locale={locale}
  path="/gift"
  structuredData={[breadcrumbSchema]}
>
  <Breadcrumbs items={breadcrumbs} />
  <section class="page section container max-w-3xl">
    <h1>{t.giftPage.title}</h1>
    <p class="text-base-content/80 mb-8">{t.giftPage.intro}</p>

    <GiftEmbed
      locale={locale}
      fallbackLabel={t.giftPage.fallbackCta}
      fallbackIntro={t.giftPage.fallbackText}
    >
    </GiftEmbed>


    <p class="mt-8 text-base-content/80 not-prose">
      {t.giftPage.contactAlternative}
      {' '}
      <a href={`mailto:${siteConfig.email}`} class="link link-primary">{siteConfig.email}</a>
    </p>
  </section>
</MainLayout>
