---
import MainLayout from '../../layouts/MainLayout.astro';
import { siteConfig } from '../../config/site';
import { locales, type Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getTranslations(locale);
---

<MainLayout title={t.seo.contact.title} description={t.seo.contact.description} locale={locale} path="/contact">
  <section class="page section container max-w-3xl">
    <h1>{t.contactPage.title}</h1>
    <p class="text-base-content/80 mb-8">{t.contactPage.intro}</p>

    <dl class="grid gap-6 sm:grid-cols-2 not-prose">
      <div>
        <dt class="font-semibold">{t.contactPage.emailLabel}</dt>
        <dd><a href={`mailto:${siteConfig.email}`} class="link link-primary">{siteConfig.email}</a></dd>
      </div>
      <div>
        <dt class="font-semibold">{t.contactPage.phoneLabel}</dt>
        <dd><a href={`tel:${siteConfig.phone.replace(/\s/g, '')}`} class="link link-primary">{siteConfig.phone}</a></dd>
      </div>
      <div>
        <dt class="font-semibold">{t.contactPage.addressLabel}</dt>
        <dd>{siteConfig.address}, {siteConfig.city}</dd>
      </div>
      <div>
        <dt class="font-semibold">{t.contactPage.areaLabel}</dt>
        <dd>{siteConfig.serviceArea}</dd>
      </div>
      {(siteConfig.instagramUrl || siteConfig.facebookUrl) && (
        <div>
          <dt class="font-semibold">{t.contactPage.socialLabel}</dt>
          <dd class="flex gap-4">
            {siteConfig.instagramUrl && (
              <a href={siteConfig.instagramUrl} class="link link-primary" target="_blank" rel="me noopener noreferrer">Instagram</a>
            )}
            {siteConfig.facebookUrl && (
              <a href={siteConfig.facebookUrl} class="link link-primary" target="_blank" rel="me noopener noreferrer">Facebook</a>
            )}
          </dd>
        </div>
      )}
    </dl>

    <div class="mt-10 rounded-box border border-base-300 p-6 not-prose">
      <p class="mb-4">{t.contactPage.bookAlternative}</p>
      <a href={`/${locale}/book`} class="btn btn-primary rounded-field">{t.common.bookNow}</a>
    </div>
  </section>
</MainLayout>
