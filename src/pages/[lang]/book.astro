---
import MainLayout from '../../layouts/MainLayout.astro';
import BookingEmbed from '../../components/BookingEmbed.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbList } from '../../lib/schema';
import { siteConfig } from '../../config/site';
import { locales, type Locale } from '../../i18n/config';
import { getTranslations } from '../../i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getTranslations(locale);

const breadcrumbs = [
  { name: t.nav.home, href: `/${locale}` },
  { name: t.nav.book, href: `/${locale}/book` },
];
const breadcrumbSchema = breadcrumbList(
  breadcrumbs.map((b) => ({ name: b.name, url: new URL(b.href, Astro.site).toString() })),
);
---

<MainLayout
  title={t.seo.book.title}
  description={t.seo.book.description}
  locale={locale}
  path="/book"
  structuredData={[breadcrumbSchema]}
>
  <Breadcrumbs items={breadcrumbs} />
  <section class="page section container max-w-3xl">
    <h1>{t.bookPage.title}</h1>
    <p class="text-base-content/80 mb-8">{t.bookPage.intro}</p>

    <BookingEmbed
      fallbackLabel={t.bookPage.fallbackCta}
      fallbackIntro={t.bookPage.fallbackText}
      startOverLabel={t.bookPage.startOver}
    />

    <p class="mt-8 text-base-content/80 not-prose">
      {t.bookPage.contactAlternative}
      {' '}
      <a href={`mailto:${siteConfig.email}`} class="link link-primary">{siteConfig.email}</a>
    </p>
  </section>
</MainLayout>
