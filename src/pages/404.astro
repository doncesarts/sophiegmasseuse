---
import MainLayout from "../layouts/MainLayout.astro";
import { defaultLocale } from "../i18n/config";
import { getTranslations } from "../i18n";

const t = getTranslations(defaultLocale);
---

<MainLayout title={t.notFound.title} description={t.notFound.body} locale={defaultLocale} path="/404" noindex>
  <section class="section flex-1 flex flex-col justify-center items-center">
    <div class="container text-center grid gap-4">
      <p class="text-6xl lg:text-8xl font-serif font-bold text-primary">404</p>
      <h1>{t.notFound.title}</h1>
      <p class="text-base-content/80">{t.notFound.body}</p>
      <a href={`/${defaultLocale}`} class="btn btn-primary rounded-field mx-auto">{t.notFound.cta}</a>
    </div>
  </section>
</MainLayout>
