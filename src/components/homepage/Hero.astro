---
import { ChevronRight } from '@lucide/astro';
import type { Locale } from '../../i18n/config';
import type { Translations } from '../../i18n/types';

interface Props {
  locale: Locale;
  t: Translations;
}

const { locale, t } = Astro.props;
---

<section class="container pt-10 lg:pt-16">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
    <div>
      <p class="uppercase tracking-wide text-sm text-secondary font-semibold mb-4">{t.hero.eyebrow}</p>
      <h1>{t.hero.headline}</h1>
      <p class="text-lg text-base-content/80 mb-2">{t.hero.subheadline}</p>
      <p class="text-base-content/80 mb-8 max-w-xl">{t.hero.intro}</p>
      <div class="flex flex-wrap gap-4">
        <a href={`/${locale}/book`} class="btn btn-primary rounded-field text-base h-auto py-3 px-6">
          {t.hero.primaryCta}
          <ChevronRight size={18} />
        </a>
        <a href={`/${locale}/services`} class="btn btn-outline btn-primary rounded-field text-base h-auto py-3 px-6">
          {t.hero.secondaryCta}
        </a>
      </div>
    </div>
    <div class="rounded-box overflow-hidden">
      <img
        src="/images/hero.jpeg"
        alt="Placeholder photograph of the massage studio"
        width="1600"
        height="1100"
        fetchpriority="high"
        loading="eager"
        class="w-full h-auto object-cover rounded-box"
      />
    </div>
  </div>
</section>
