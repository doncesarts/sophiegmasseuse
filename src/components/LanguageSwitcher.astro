---
// Reusable, accessible language switcher. Pure links (no client JS) that
// preserve the current page by swapping only the locale segment of the URL.
import { locales, localeNames, type Locale } from '../i18n/config';

interface Props {
  locale: Locale;
  /** Locale-agnostic path of the current page, e.g. "/services/swedish-massage". */
  path: string;
  class?: string;
}

const { locale, path, class: className } = Astro.props;
const normalizedPath = path === '/' ? '' : path;
---

<nav aria-label="Language" class:list={['flex items-center gap-1', className]}>
  <span class="sr-only">Language:</span>
  <ul class="flex items-center gap-1">
    {locales.map((loc) => (
      <li>
        <a
          href={`/${loc}${normalizedPath}`}
          aria-current={loc === locale ? 'true' : undefined}
          class:list={[
            'inline-flex items-center justify-center rounded-field px-2.5 py-1 text-sm font-medium transition-colors',
            loc === locale
              ? 'bg-primary text-primary-content'
              : 'text-base-content/70 hover:bg-base-200 hover:text-base-content',
          ]}
        >
          <span class="sr-only">{localeNames[loc]}</span>
          <span aria-hidden="true">{loc.toUpperCase()}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
