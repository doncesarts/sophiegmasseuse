---
// Injects SEO metadata, canonical/hreflang links, Open Graph / Twitter tags
// and LocalBusiness JSON-LD. All business facts come from `siteConfig` so
// rebranding only requires editing `src/config/site.ts`.
import '../styles/global.css';
import { Font } from 'astro:assets';
import { siteConfig } from '../config/site';
import { locales, defaultLocale, type Locale } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  /** Path to the social sharing image under /public. Defaults to siteConfig.socialImage. */
  image?: string;
  /** Current locale of the page. */
  locale: Locale;
  /** Locale-agnostic path, e.g. "/", "/services", "/services/swedish-massage". */
  path: string;
  /** Set true on error/utility pages (404, 500) to keep them out of search results. */
  noindex?: boolean;
  /** Extra schema.org nodes (Service, FAQPage, BreadcrumbList...) to emit alongside the LocalBusiness graph. */
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = siteConfig.socialImage,
  locale,
  path,
  noindex = false,
  structuredData = [],
} = Astro.props;

const normalizedPath = path === '/' ? '' : path;
const localizedPath = `/${locale}${normalizedPath}`;
const canonicalURL = new URL(localizedPath, Astro.site);
const imageURL = new URL(image, Astro.site);
const businessId = new URL(`/${defaultLocale}#business`, Astro.site).toString();

const localBusinessNode = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  '@id': businessId,
  name: siteConfig.name,
  description: siteConfig.seo.defaultDescription,
  image: imageURL.toString(),
  logo: new URL(siteConfig.logo, Astro.site).toString(),
  url: new URL(`/${defaultLocale}`, Astro.site).toString(),
  telephone: siteConfig.phone,
  email: siteConfig.email,
  priceRange: siteConfig.priceRange,
  address: {
    '@type': 'PostalAddress',
    streetAddress: siteConfig.address,
    addressLocality: siteConfig.city.split(',')[0].trim(),
    addressCountry: 'CH',
  },
  ...(siteConfig.geo
    ? {
        geo: {
          '@type': 'GeoCoordinates',
          latitude: siteConfig.geo.latitude,
          longitude: siteConfig.geo.longitude,
        },
      }
    : {}),
  ...(siteConfig.googleMapsUrl ? { hasMap: siteConfig.googleMapsUrl } : {}),
  areaServed: siteConfig.serviceArea,
  openingHoursSpecification: siteConfig.openingHours,
  sameAs: [siteConfig.instagramUrl, siteConfig.facebookUrl, siteConfig.googleMapsUrl].filter(Boolean),
};

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [localBusinessNode, ...structuredData],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
<link rel="icon" href="/favicon/favicon.ico" />
<link rel="manifest" href="/favicon/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical + hreflang -->
<link rel="canonical" href={canonicalURL} />
{locales.map((loc) => (
  <link
    rel="alternate"
    hreflang={loc}
    href={new URL(`/${loc}${normalizedPath}`, Astro.site).toString()}
  />
))}
<link
  rel="alternate"
  hreflang="x-default"
  href={new URL(`/${defaultLocale}${normalizedPath}`, Astro.site).toString()}
/>

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:locale" content={locale} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdGraph)} />
