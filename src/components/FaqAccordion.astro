---
import type { FaqItem } from '../i18n/types';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="grid gap-3">
  {items.map((item) => (
    <details class="group rounded-box border border-base-300 bg-base-100 p-5 open:pb-6">
      <summary class="cursor-pointer list-none flex items-center justify-between gap-4 font-serif text-lg font-semibold">
        {item.question}
        <span class="shrink-0 transition-transform group-open:rotate-45 text-primary" aria-hidden="true">+</span>
      </summary>
      <p class="mt-3 text-base-content/80">{item.answer}</p>
    </details>
  ))}
</div>
