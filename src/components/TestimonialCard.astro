---
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'testimonials'>['data'];

const { name, location, quote, rating } = Astro.props;
---

<figure class="rounded-box border border-base-300 bg-base-100 p-8 flex flex-col gap-4">
  <div class="text-accent" aria-hidden="true">{'★'.repeat(rating)}{'☆'.repeat(5 - rating)}</div>
  <blockquote class="text-lg font-serif text-base-content/90">&ldquo;{quote}&rdquo;</blockquote>
  <figcaption class="text-sm text-base-content/70">
    {name}{location ? `, ${location}` : ''}
  </figcaption>
</figure>
