---
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { Menu } from '@lucide/astro';
import type { Locale } from '../i18n/config';
import type { Translations } from '../i18n/types';

interface Props {
  locale: Locale;
  path: string;
  t: Translations;
}

const { locale, path, t } = Astro.props;

const navItems = [
  { href: `/${locale}`, label: t.nav.home },
  { href: `/${locale}/services`, label: t.nav.services },
  { href: `/${locale}/about`, label: t.nav.about },
  { href: `/${locale}/faq`, label: t.nav.faq },
  { href: `/${locale}/contact`, label: t.nav.contact },
];
---

<header class="border-b border-base-300/60">
	<nav class="container grid grid-cols-[auto_1fr_auto] py-4 items-center gap-3" aria-label="Primary">
		<Logo locale={locale} />
		<div class="hidden lg:flex gap-8 items-center mx-auto">
			{navItems.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
		</div>
		<div class="flex items-center gap-3 ml-auto">
			<LanguageSwitcher locale={locale} path={path} class="hidden md:flex" />
			<a href={`/${locale}/book`} class="btn btn-primary rounded-field text-base h-auto py-2.5 px-5 shadow-sm hover:shadow-md">{t.nav.book}</a>
			<label for="mobile-drawer" aria-label="Open navigation menu" class="btn btn-square btn-ghost lg:hidden">
				<Menu />
			</label>
		</div>
	</nav>
</header>
