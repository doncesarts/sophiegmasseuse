---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const isActive = href === pathname || (typeof href === 'string' && pathname.startsWith(`${href}/`));
---

<a href={href} aria-current={isActive ? 'page' : undefined} class:list={[className, { active: isActive }, 'hover:text-primary transition-colors']} {...props}>
	<slot />
</a>
<style>
	a.active {
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 4px;
		color: var(--color-primary);
	}
</style>
