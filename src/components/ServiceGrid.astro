---
import ServiceCard from './ServiceCard.astro';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/config';
import type { Translations } from '../i18n/types';

interface Props {
  services: CollectionEntry<'services'>[];
  locale: Locale;
  t: Translations;
}

const { services, locale, t } = Astro.props;

function slugOf(entry: CollectionEntry<'services'>) {
  // ids are like "en/swedish-massage" — strip the locale prefix.
  return entry.id.split('/').pop();
}
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
  {services.map((service) => (
    <ServiceCard
      title={service.data.title}
      shortDescription={service.data.shortDescription}
      duration={service.data.duration}
      price={service.data.price}
      currency={service.data.currency}
      options={service.data.options}
      image={service.data.image}
      imageAlt={service.data.imageAlt}
      href={`/${locale}/services/${slugOf(service)}`}
      t={t}
    />
  ))}
</div>
