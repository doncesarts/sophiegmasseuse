---
import { siteConfig } from '../config/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import WhatsAppLink from './WhatsAppLink.astro';
import type { Locale } from '../i18n/config';
import type { Translations } from '../i18n/types';

interface Props {
  locale: Locale;
  path: string;
  t: Translations;
}

const { locale, path, t } = Astro.props;
const today = new Date();

const navItems = [
  { href: `/${locale}`, label: t.nav.home },
  { href: `/${locale}/services`, label: t.nav.services },
  { href: `/${locale}/about`, label: t.nav.about },
  { href: `/${locale}/faq`, label: t.nav.faq },
  { href: `/${locale}/contact`, label: t.nav.contact },
  { href: `/${locale}/book`, label: t.nav.book },
];
---

<footer class="footer w-full bg-base-200 gap-0">
  <div class="footer-top w-full py-14">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_1fr_1fr] gap-10">
        <div>
          <a href={`/${locale}`} class="inline-block">
            <img src={siteConfig.logo} alt={`${siteConfig.name} logo`} width="168" height="42" class="w-auto h-11" />
          </a>
          <p class="mt-4 max-w-sm text-base-content/80">{t.footer.description}</p>
        </div>
        <div>
          <h3 class="text-primary font-serif">{t.footer.navTitle}</h3>
          <nav class="grid gap-3 mt-3" aria-label="Footer">
            {navItems.map((item) => (
              <a href={item.href} class="hover:text-primary hover:underline">{item.label}</a>
            ))}
          </nav>
        </div>
        <div>
          <h3 class="text-primary font-serif">{t.footer.contactTitle}</h3>
          <nav class="grid gap-3 mt-3">
            <a href={`mailto:${siteConfig.email}`} class="hover:text-primary hover:underline">{siteConfig.email}</a>
            <span class="inline-flex items-center gap-3">
              <a href={`tel:${siteConfig.phone.replace(/\s/g, '')}`} class="hover:text-primary hover:underline">{siteConfig.phone}</a>
              <WhatsAppLink label={t.contactPage.whatsappLabel} />
            </span>
            <span>{siteConfig.address}</span>
          </nav>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-btm w-full">
    <div class="container pb-6">
      <hr class="border-t border-base-300 mb-6" />
      <div class="flex flex-wrap gap-4 items-center justify-between">
        <div class="flex flex-wrap gap-4 items-center">
          {siteConfig.instagramUrl && (
            <a href={siteConfig.instagramUrl} class="inline-flex items-center justify-center hover:text-primary" title="Instagram" aria-label="Instagram" rel="me noopener noreferrer" target="_blank">
              <svg viewBox="0 0 24 24" width="1.4em" height="1.4em" aria-hidden="true" fill="currentColor">
                <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm5.25-3.25a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z" />
              </svg>
            </a>
          )}
          {siteConfig.facebookUrl && (
            <a href={siteConfig.facebookUrl} class="inline-flex items-center justify-center hover:text-primary" title="Facebook" aria-label="Facebook" rel="me noopener noreferrer" target="_blank">
              <svg viewBox="0 0 24 24" width="1.4em" height="1.4em" aria-hidden="true" fill="currentColor">
                <path d="M13.5 21v-8.2h2.8l.4-3.2h-3.2V7.5c0-.9.3-1.5 1.6-1.5h1.7V3.1c-.3 0-1.4-.1-2.6-.1-2.6 0-4.3 1.6-4.3 4.5v2.1H7v3.2h2.9V21h3.6Z" />
              </svg>
            </a>
          )}
        </div>
        <LanguageSwitcher locale={locale} path={path} />
        <p class="text-sm text-base-content/70">
          &copy; {today.getFullYear()} {siteConfig.name}. {t.footer.rightsReserved}
        </p>
        <div class="flex flex-wrap gap-4 text-sm">
          <a href={`/${locale}/health-safety`} class="hover:text-primary hover:underline">{t.footer.healthSafety}</a>
          <a href={`/${locale}/privacy`} class="hover:text-primary hover:underline">{t.footer.privacy}</a>
          <a href={`/${locale}/legal`} class="hover:text-primary hover:underline">{t.footer.legal}</a>
          <a href={`/${locale}/terms`} class="hover:text-primary hover:underline">{t.footer.terms}</a>
        </div>
      </div>
    </div>
  </div>
</footer>
