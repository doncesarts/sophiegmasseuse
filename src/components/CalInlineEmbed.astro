---
// Isolated Cal.com inline embed for a single event type. Swapping providers
// later only requires editing this component — pages just pass a calLink.
// Collapsed behind a <details> toggle so the calendar doesn't take up space
// (or load its script) until the visitor actually wants to book.
interface Props {
  /** Cal.com event link, e.g. "sophiegmassage/balinese-massage-full-body-60-minutes". */
  calLink: string;
  /** Accessible name for the toggle, since its visible content may not fully describe the action. */
  ariaLabel?: string;
  /** Label for the button shown above the open calendar, e.g. "Close". */
  closeLabel?: string;
  class?: string;
  summaryClass?: string;
}

const {
  calLink,
  ariaLabel,
  closeLabel = 'Close',
  class: className,
  summaryClass = 'link link-primary text-sm whitespace-nowrap',
} = Astro.props;
// Cal.com namespaces must be unique per embedded event type on a page.
const namespace = calLink.split('/').pop() ?? calLink;
const elementId = `my-cal-inline-${namespace}`;
---

<details class:list={['cal-inline-embed', className]}>
  <summary
    class:list={['list-none cursor-pointer [&::-webkit-details-marker]:hidden', summaryClass]}
    aria-label={ariaLabel}
  >
    <slot />
  </summary>
  <div class="mt-4 min-h-[720px] bg-base-100 rounded-box">
    <button
      type="button"
      class="btn btn-ghost btn-xs mb-2"
      onclick="this.closest('details').removeAttribute('open')"
    >
      &larr; {closeLabel}
    </button>
    <div id={elementId} style="width:100%;height:100%;overflow:scroll"></div>
  </div>
  <script is:inline type="text/javascript" define:vars={{ calLink, namespace, elementId }}>
    document.currentScript.closest('details').addEventListener(
      'toggle',
      function onToggle(event) {
        if (!event.target.open) return;
        event.target.removeEventListener('toggle', onToggle);

        (function (C, A, L) {
          let p = function (a, ar) { a.q.push(ar); };
          let d = C.document;
          C.Cal = C.Cal || function () {
            let cal = C.Cal;
            let ar = arguments;
            if (!cal.loaded) {
              cal.ns = {};
              cal.q = cal.q || [];
              d.head.appendChild(d.createElement('script')).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () { p(api, arguments); };
              const ns = ar[1];
              api.q = api.q || [];
              if (typeof ns === 'string') {
                cal.ns[ns] = cal.ns[ns] || api;
                p(cal.ns[ns], ar);
                p(cal, ['initNamespace', ns]);
              } else {
                p(cal, ar);
              }
              return;
            }
            p(cal, ar);
          };
        })(window, 'https://app.cal.com/embed/embed.js', 'init');

        Cal('init', namespace, { origin: 'https://app.cal.com' });
        Cal.config = Cal.config || {};
        Cal.config.forwardQueryParams = true;

        Cal.ns[namespace]('inline', {
          elementOrSelector: '#' + elementId,
          config: { layout: 'month_view', useSlotsViewOnSmallScreen: 'true' },
          calLink: calLink,
        });

        // Read the site's actual theme tokens so the embed's background/text
        // stay in sync with global.css instead of duplicating hardcoded colors here.
        const rootStyle = getComputedStyle(document.documentElement);
        const bg = rootStyle.getPropertyValue('--color-base-100').trim();
        const text = rootStyle.getPropertyValue('--color-base-content').trim();
        const border = rootStyle.getPropertyValue('--color-base-300').trim();
        const theme = { 'cal-bg': bg, 'cal-bg-emphasis': bg, 'cal-border': border, 'cal-text': text };

        Cal.ns[namespace]('ui', {
          hideEventTypeDetails: false,
          layout: 'month_view',
          cssVarsPerTheme: { light: theme, dark: theme },
        });
      },
      { once: true },
    );
  </script>
</details>
